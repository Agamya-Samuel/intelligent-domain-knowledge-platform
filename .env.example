# ============================================================
# IDKP Environment Configuration
# Copy to .env and fill in the values.
# ============================================================

# === Database (PostgreSQL 16) ===
DATABASE_URL=postgresql+asyncpg://idkp:idkp_secret@localhost:5432/idkp
POSTGRES_USER=idkp
POSTGRES_PASSWORD=idkp_secret
POSTGRES_DB=idkp
POSTGRES_PORT=5432

# === Redis 7 ===
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# === Auth (Auth.js v5 / NextAuth) ===
# Generate with: openssl rand -base64 32
AUTH_SECRET=generate-a-random-secret-here
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# === Backend (FastAPI) ===
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# === Nginx ===
NGINX_PORT=80

# === Modal.com (serverless GPU) ===
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# === AWS S3 ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=idkp-documents-dev

# === Qdrant Cloud (vector DB) ===
QDRANT_URL=
QDRANT_API_KEY=

# === Langfuse (self-hosted LLM observability) ===
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PORT=3001
LANGFUSE_NEXTAUTH_SECRET=langfuse-dev-secret-change-in-prod
LANGFUSE_SALT=langfuse-dev-salt-change-in-prod

# === Evaluation / RAGAS ===
# Evaluator LLM — used by RAGAS as the judge model for scoring.
# Defaults to the main LLM endpoint if left empty.
EVAL_LLM_BASE_URL=
EVAL_LLM_MODEL=
EVAL_LLM_API_KEY=not-needed
EVAL_MAX_CONCURRENCY=3
EVAL_TIMEOUT_SECONDS=300

# === LLM Inference (Modal vLLM) ===
# Base model served by vLLM on Modal.com.
LLM_BASE_URL=http://localhost:8001
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# LoRA adapter name for the fine-tuned variant. Must match a loaded adapter
# in vLLM's --lora-modules config (e.g., "default-adapters").
# When empty, the finetuned variant falls back to the base model.
LLM_FINETUNED_ADAPTER=default-adapters
