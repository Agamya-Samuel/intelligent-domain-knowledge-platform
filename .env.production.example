# ============================================================
# IDKP Production Environment Configuration
# Copy to .env.production and fill in production values.
# NEVER commit .env.production to version control.
# ============================================================

# === Database (PostgreSQL 16 — production) ===
DATABASE_URL=postgresql+asyncpg://idkp:<strong-password>@localhost:5432/idkp
POSTGRES_USER=idkp
POSTGRES_PASSWORD=<GENERATE_SECURE_PASSWORD_32_CHARS>
POSTGRES_DB=idkp
PROD_POSTGRES_PORT=5432

# === Redis 7 — production ===
REDIS_URL=redis://localhost:6379/0
PROD_REDIS_PORT=6379

# === Auth (Auth.js v5 — production secrets) ===
# Generate: openssl rand -base64 32
AUTH_SECRET=<GENERATE_SECURE_SECRET>
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=<production-google-client-id>
AUTH_GOOGLE_SECRET=<production-google-client-secret>
AUTH_GITHUB_ID=<production-github-client-id>
AUTH_GITHUB_SECRET=<production-github-client-secret>

# === Backend (FastAPI — production) ===
BACKEND_URL=https://idkp.example.com
FRONTEND_URL=https://idkp.example.com
DEBUG=false

# === Production Domain ===
PROD_DOMAIN=idkp.example.com

# === Modal.com (serverless GPU — production) ===
MODAL_TOKEN_ID=<production-modal-token-id>
MODAL_TOKEN_SECRET=<production-modal-token-secret>

# === AWS S3 — production bucket ===
AWS_ACCESS_KEY_ID=<production-aws-access-key>
AWS_SECRET_ACCESS_KEY=<production-aws-secret-key>
AWS_REGION=us-east-1
S3_BUCKET_NAME=idkp-documents-prod

# === Qdrant Cloud — production cluster ===
QDRANT_URL=<qdrant-cloud-production-url>
QDRANT_API_KEY=<qdrant-cloud-production-api-key>

# === Langfuse — production instance ===
LANGFUSE_PUBLIC_KEY=<langfuse-production-public-key>
LANGFUSE_SECRET_KEY=<langfuse-production-secret-key>
LANGFUSE_HOST=https://langfuse.idkp.example.com
PROD_LANGFUSE_PORT=3001
PROD_LANGFUSE_URL=https://langfuse.idkp.example.com
LANGFUSE_NEXTAUTH_SECRET=<GENERATE_SECURE_SECRET>
LANGFUSE_SALT=<GENERATE_SECURE_SALT>

# === Evaluation / RAGAS — production ===
EVAL_LLM_BASE_URL=<evaluator-llm-endpoint>
EVAL_LLM_MODEL=<evaluator-model-name>
EVAL_LLM_API_KEY=<evaluator-api-key>
EVAL_MAX_CONCURRENCY=2
EVAL_TIMEOUT_SECONDS=600

# === Budget Alerts ===
BUDGET_MONTHLY_LIMIT=30.00
BUDGET_ALERT_THRESHOLD=0.80
BUDGET_HARD_BLOCK=false
