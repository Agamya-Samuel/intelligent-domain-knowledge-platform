# ============================================================
# IDKP Staging Environment Configuration
# Copy from .env.example and override for staging.
# ============================================================

# === Database (PostgreSQL 16 — staging) ===
DATABASE_URL=postgresql+asyncpg://idkp:idkp_staging_secret@localhost:5433/idkp_staging
POSTGRES_USER=idkp
POSTGRES_PASSWORD=idkp_staging_secret
POSTGRES_DB=idkp_staging
STAGING_POSTGRES_PORT=5433

# === Redis 7 — staging ===
REDIS_URL=redis://localhost:6380/1
STAGING_REDIS_PORT=6380

# === Auth (Auth.js v5 — staging secret) ===
AUTH_SECRET=generate-a-staging-secret-here
AUTH_TRUST_HOST=true

# === Backend ===
BACKEND_URL=http://localhost:8001
FRONTEND_URL=http://localhost:3001

# === Nginx — staging ===
STAGING_NGINX_PORT=8080

# === Modal.com ===
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# === AWS S3 — staging bucket ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=idkp-documents-staging

# === Qdrant Cloud — staging collection ===
QDRANT_URL=
QDRANT_API_KEY=

# === Langfuse — staging instance ===
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3002
STAGING_LANGFUSE_PORT=3002
LANGFUSE_NEXTAUTH_SECRET=staging-langfuse-secret-change-in-prod
LANGFUSE_SALT=staging-langfuse-salt-change-in-prod

# === Evaluation ===
EVAL_LLM_BASE_URL=
EVAL_LLM_MODEL=
EVAL_LLM_API_KEY=not-needed
EVAL_MAX_CONCURRENCY=3
EVAL_TIMEOUT_SECONDS=300
